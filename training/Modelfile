# Ollama model for the fine-tuned Hassaniya assistant.
# 1) merge LoRA:   python3 training/finetune_llm_lora.py --merge runs/dar-3b
# 2) GGUF:         python3 llama.cpp/convert_hf_to_gguf.py runs/dar-3b/merged --outfile runs/dar-3b.f16.gguf
#                  llama.cpp/build/bin/llama-quantize runs/dar-3b.f16.gguf runs/dar-3b.Q4_K_M.gguf Q4_K_M
# 3) TEMPLATE: copy the TEMPLATE block from `ollama show qwen2.5:3b --modelfile` below if your
#    Ollama version does not auto-detect it (needed for tool calling).
# 4) ollama create dar -f training/Modelfile
FROM ../runs/dar-3b.Q4_K_M.gguf
PARAMETER temperature 0.2
PARAMETER num_ctx 8192
PARAMETER stop <|im_end|>
